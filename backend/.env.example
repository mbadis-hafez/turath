APP_NAME="Bidayaat"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
APP_PORT=8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=Asia/Riyadh

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bidayaat
DB_USERNAME=root
DB_PASSWORD=
DB_TEST_DATABASE=bidayaat_test

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

SANCTUM_STATEFUL_DOMAINS=localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME="${APP_NAME}"
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OCR pipeline (config/ocr.php): recognize → extract → match → correct, one queued job per
# stage. Empty queue names use the default queue. REDIS_QUEUE_RETRY_AFTER must be
# longer than the longest stage timeout (default 1800s) — raise it, or give OCR its
# own queue connection. Workers need --timeout at least as long as well.
OCR_QUEUE=
OCR_AI_QUEUE=
OCR_RECOGNIZE_TIMEOUT=1800
OCR_EXTRACT_TIMEOUT=120
OCR_MATCH_TIMEOUT=300
OCR_CORRECT_TIMEOUT=1800

# AI OCR correction (config/ocr.php). Off by default; printed-text regions only,
# with emails, links and numbers masked before sending. External providers also
# need OCR_CORRECTION_ALLOW_EXTERNAL=true and only receive material at or below
# OCR_CORRECTION_EXTERNAL_MAX_ACCESS_LEVEL — check data-residency rules first.
OCR_CORRECTION_ENABLED=false
OCR_CORRECTION_PROVIDER=none
OCR_CORRECTION_ALLOW_EXTERNAL=false
OCR_CORRECTION_EXTERNAL_MAX_ACCESS_LEVEL=public
ANTHROPIC_API_KEY=
OCR_CORRECTION_ANTHROPIC_MODEL=claude-sonnet-5
# OpenAI, Gemini's OpenAI-compatible endpoint, or a local server (Ollama, vLLM).
OCR_CORRECTION_OPENAI_LABEL=openai_compatible
OCR_CORRECTION_OPENAI_BASE_URL=https://api.openai.com/v1
OCR_CORRECTION_OPENAI_API_KEY=
OCR_CORRECTION_OPENAI_MODEL=
OCR_CORRECTION_OPENAI_EXTERNAL=true

# Handwriting suggestions (config/ocr.php). Off by default: handwriting is transcribed
# by hand. A suggestion is never a verified value until a reviewer submits it.
OCR_HANDWRITING_ENABLED=false
OCR_HANDWRITING_PROVIDER=none
OCR_HANDWRITING_ALLOW_EXTERNAL=false
OCR_HANDWRITING_EXTERNAL_MAX_ACCESS_LEVEL=public
# Self-hosted kraken 7 + Muharaf model (Arabic script only): https://zenodo.org/records/14295489
OCR_HANDWRITING_KRAKEN_BINARY=kraken
OCR_HANDWRITING_KRAKEN_MODEL=
# Azure Document Intelligence prebuilt-read (external).
OCR_HANDWRITING_AZURE_ENDPOINT=
OCR_HANDWRITING_AZURE_KEY=
