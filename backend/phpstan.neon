includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - app
    # Laravel 13 merges method-based casts() in initializeHasAttributes(), which
    # larastan's constructor-less model reflection skips; parse the method AST
    # instead so cast types (Carbon, custom casts) are visible to analysis.
    parseModelCastsMethod: true
